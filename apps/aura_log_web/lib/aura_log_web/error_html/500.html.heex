<section style="min-height:100vh;display:grid;place-items:center;background:#0b1020;color:#e5ecff;font-family:Inter,Segoe UI,system-ui,sans-serif;">
  <div style="max-width:640px;padding:2rem;border:1px solid #223457;border-radius:12px;background:linear-gradient(180deg,#111a2e,#17233e);box-shadow:0 12px 30px rgba(4,8,20,.35);">
    <p style="margin:0 0 .5rem;color:#9db0d3;font-size:.9rem;">AuraLog</p>
    <h1 style="margin:.2rem 0 0;font-size:2rem;">500 - Internal server error</h1>
    <p style="margin:1rem 0 1.4rem;line-height:1.5;color:#c7d5f3;">
      Something went wrong while serving this page. Please retry in a moment.
    </p>
    <a href="/dashboard" style="display:inline-block;padding:.65rem 1rem;background:#2563eb;color:#fff;text-decoration:none;border-radius:10px;font-weight:600;">
      Back to dashboard
    </a>
  </div>
</section>
