# Copy to .env and fill before production deploy (never commit .env)

# Required for production (docker-compose.prod.yml / release)
SECRET_KEY_BASE=generate-with-mix-phx-gen-secret
AURALOG_INGEST_JWT_SECRET=generate-a-long-random-string

# Optional
# PORT=4000
# PHX_SERVER=true
# AURALOG_DUCKDB_PATH=/data/auralog.duckdb

# UDP ingest (off by default in production; do not expose 9000/udp publicly)
AURALOG_UDP_INGEST_ENABLED=false
# Required only when UDP is enabled:
# AURALOG_UDP_INGEST_TOKEN=generate-a-long-random-string
